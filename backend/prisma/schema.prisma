generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  users       User[]
  invitations Invitation[]

  @@map("roles")
}

model User {
  id                      String              @id @default(uuid()) @db.Uuid
  roleId                  String              @map("role_id") @db.Uuid
  email                   String              @unique
  passwordHash            String?             @map("password_hash")
  isActive                Boolean             @default(true) @map("is_active")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  role                    Role                @relation(fields: [roleId], references: [id])
  oauthIdentities         OAuthIdentity[]
  sessions                Session[]
  invitationsSent         Invitation[]        @relation("InvitedBy")
  studentProfile          StudentProfile?
  counselorProfile        CounselorProfile?
  mentorProfile           MentorProfile?
  recruiterProfile        RecruiterProfile?
  jobsPosted              Job[]               @relation("UserJobs")
  mentorshipRequestsSent  MentorshipRequest[] @relation("InitiatedRequests")
  conversationsAsP1       Conversation[]      @relation("ConversationP1")
  conversationsAsP2       Conversation[]      @relation("ConversationP2")
  messages                Message[]
  notifications           Notification[]
  activityLogs            ActivityLog[]

  @@index([roleId])
  @@map("users")
}

model OAuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  invitedById String    @map("invited_by") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  email       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  role        Role      @relation(fields: [roleId], references: [id])

  @@index([invitedById])
  @@index([roleId])
  @@index([email, expiresAt])
  @@map("invitations")
}

model StudentProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  studentNumber      String              @unique @map("student_number")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  course             String
  yearLevel          Int                 @map("year_level")
  gpa                Decimal?            @db.Decimal(4, 2)
  phone              String
  address            String
  bio                String?
  location           String?
  careerStatus       String?             @map("career_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes            Resume[]
  savedJobs          SavedJob[]
  jobApplications    JobApplication[]
  mentorshipRequests MentorshipRequest[]
  mentorships        Mentorship[]
  appointments       Appointment[]

  @@map("student_profiles")
}

model CounselorProfile {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @unique @map("user_id") @db.Uuid
  employeeId     String                  @unique @map("employee_id")
  department     String
  phone          String
  isAvailable    Boolean                 @default(true) @map("is_available")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes        Resume[]
  resumeReviews  ResumeReview[]
  appointments   Appointment[]
  availabilities CounselorAvailability[]

  @@map("counselor_profiles")
}

model MentorProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  professionalTitle  String              @map("professional_title")
  companyName        String              @map("company_name")
  industry           String
  biography          String
  expertise          String
  phone              String
  maxMentees         Int                 @default(3) @map("max_mentees")
  availabilityNotes  String?             @map("availability_notes")
  approvalStatus     String              @default("pending") @map("approval_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorshipRequests MentorshipRequest[]
  mentorships        Mentorship[]
  appointments       Appointment[]

  @@index([approvalStatus])
  @@map("mentor_profiles")
}

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  industry           String
  description        String?
  website            String?
  location           String?
  verificationStatus String             @default("pending") @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")

  recruiterProfiles  RecruiterProfile[]
  jobs               Job[]

  @@index([verificationStatus])
  @@map("companies")
}

model RecruiterProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  jobTitle       String   @map("job_title")
  phone          String
  approvalStatus String   @default("pending") @map("approval_status")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([approvalStatus])
  @@map("recruiter_profiles")
}

model Resume {
  id                  String           @id @default(uuid()) @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  counselorId         String?          @map("counselor_id") @db.Uuid
  fileUrl             String           @map("file_url")
  version             String           @default("1.0")
  isCurrent           Boolean          @default(true) @map("is_current")
  isCounselorVerified Boolean          @default(false) @map("is_counselor_verified")
  verificationCode    String?          @unique @map("verification_code")
  verifiedAt          DateTime?        @map("verified_at")
  uploadedAt          DateTime         @default(now()) @map("uploaded_at")

  student             StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselor           CounselorProfile? @relation(fields: [counselorId], references: [id], onDelete: SetNull)
  resumeReviews       ResumeReview[]
  jobApplications     JobApplication[]

  @@index([studentId])
  @@index([counselorId])
  @@map("resumes")
}

model ResumeReview {
  id          String           @id @default(uuid()) @db.Uuid
  resumeId    String           @map("resume_id") @db.Uuid
  counselorId String           @map("counselor_id") @db.Uuid
  rating      Int
  feedback    String
  status      String           @default("reviewed")
  reviewedAt  DateTime         @default(now()) @map("reviewed_at")

  resume      Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  counselor   CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([counselorId])
  @@map("resume_reviews")
}

model Job {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  postedById          String           @map("posted_by") @db.Uuid
  title               String
  description         String
  requirements        String?
  employmentType      String           @map("employment_type")
  location            String
  salaryRange         String?          @map("salary_range")
  applicationDeadline DateTime?        @map("application_deadline") @db.Date
  status              String           @default("open")
  postedAt            DateTime         @default(now()) @map("posted_at")

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy            User             @relation("UserJobs", fields: [postedById], references: [id], onDelete: Restrict)
  savedByStudents     SavedJob[]
  applications        JobApplication[]

  @@index([companyId])
  @@index([postedById])
  @@index([status, postedAt])
  @@map("jobs")
}

model SavedJob {
  studentId String         @map("student_id") @db.Uuid
  jobId     String         @map("job_id") @db.Uuid
  savedAt   DateTime       @default(now()) @map("saved_at")

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([studentId, jobId])
  @@map("saved_jobs")
}

model JobApplication {
  id          String         @id @default(uuid()) @db.Uuid
  jobId       String         @map("job_id") @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  resumeId    String?        @map("resume_id") @db.Uuid
  status      String         @default("submitted")
  coverLetter String?        @map("cover_letter")
  appliedAt   DateTime       @default(now()) @map("applied_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resume      Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([jobId, studentId])
  @@index([studentId])
  @@index([resumeId])
  @@map("job_applications")
}

model MentorshipRequest {
  id              String         @id @default(uuid()) @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  mentorId        String         @map("mentor_id") @db.Uuid
  initiatedById   String         @map("initiated_by") @db.Uuid
  message         String
  status          String         @default("pending")
  responseMessage String?        @map("response_message")
  createdAt       DateTime       @default(now()) @map("created_at")
  respondedAt     DateTime?      @map("responded_at")

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor          MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  initiatedBy     User           @relation("InitiatedRequests", fields: [initiatedById], references: [id], onDelete: Cascade)
  mentorship      Mentorship?

  @@index([studentId])
  @@index([mentorId])
  @@index([initiatedById])
  @@map("mentorship_requests")
}

model Mentorship {
  id               String            @id @default(uuid()) @db.Uuid
  requestId        String            @unique @map("request_id") @db.Uuid
  studentId        String            @map("student_id") @db.Uuid
  mentorId         String            @map("mentor_id") @db.Uuid
  status           String            @default("active")
  goals            String?
  meetingFrequency String?           @map("meeting_frequency")
  startedAt        DateTime?         @map("started_at") @db.Date
  endedAt          DateTime?         @map("ended_at") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  request          MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  student          StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor           MentorProfile     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  appointments     Appointment[]

  @@index([studentId])
  @@index([mentorId])
  @@map("mentorships")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  counselorId     String?           @map("counselor_id") @db.Uuid
  mentorId        String?           @map("mentor_id") @db.Uuid
  mentorshipId    String?           @map("mentorship_id") @db.Uuid
  appointmentType String            @map("appointment_type")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  startTime       String            @map("start_time")
  endTime         String            @map("end_time")
  status          String            @default("scheduled")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")

  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselor       CounselorProfile? @relation(fields: [counselorId], references: [id], onDelete: SetNull)
  mentor          MentorProfile?    @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  mentorship      Mentorship?       @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([counselorId])
  @@index([mentorId])
  @@index([mentorshipId])
  @@index([appointmentDate])
  @@map("appointments")
}

model CounselorAvailability {
  id          String           @id @default(uuid()) @db.Uuid
  counselorId String           @map("counselor_id") @db.Uuid
  dayOfWeek   Int              @map("day_of_week")
  startTime   String           @map("start_time")
  endTime     String           @map("end_time")
  isWalkIn    Boolean          @default(false) @map("is_walk_in")

  counselor   CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([counselorId])
  @@map("counselor_availability")
}

model Conversation {
  id             String    @id @default(uuid()) @db.Uuid
  participant1Id String    @map("participant_1_id") @db.Uuid
  participant2Id String    @map("participant_2_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  participant1   User      @relation("ConversationP1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User      @relation("ConversationP2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  sentAt         DateTime     @default(now()) @map("sent_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String
  title         String
  message       String
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}
