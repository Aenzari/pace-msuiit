generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  counselor
  recruiter
  admin
  superadmin
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String?          @map("password_hash")
  role            UserRole         @default(student)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  oauthIdentities OAuthIdentity[]
  sessions        Session[]
  invitations     Invitation[]     @relation("InvitedBy")
  studentProfile  StudentProfile?
  counselorProfile CounselorProfile?
  recruiterProfile RecruiterProfile?

  @@map("users")
}

model StudentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  schoolId  String   @unique @map("school_id")
  course    String
  yearLevel Int      @map("year_level")
  phone     String
  address   String
  resumeUrl String?  @map("resume_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CounselorProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  employeeId String   @unique @map("employee_id")
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counselor_profiles")
}

model RecruiterProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  companyName String   @map("company_name")
  companyId   String   @map("company_id")
  jobTitle    String   @map("job_title")
  phone       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model OAuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("oauth_identities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  role       UserRole
  tokenHash  String    @unique @map("token_hash")
  invitedById String   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  invitedBy  User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
  @@map("invitations")
}
